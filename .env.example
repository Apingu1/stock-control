DB_HOST=db
DB_PORT=5432
DB_NAME=stock
DB_USER=stock
DB_PASSWORD=stockpass
JWT_SECRET=change_me_stock
TZ=Europe/London
FEATURE_STOCK_CONTROL=true
FEATURE_REQUIRE_SECOND_CHECK=false
FEATURE_REQUIRE_SCAN=false

# Backup output directory inside the API container (mapped to host via docker-compose)
BACKUP_DIR=/backups

# Physical host/server destination. The Windows Backup Settings utility updates
# this value and safely reconnects the backup services to the selected folder.
BACKUP_HOST_PATH=../Backups

# Runtime state is fixed so a folder change cannot reset the active dataset,
# maintenance state, automatic schedule, or administrative backup audit log.
APP_STATE_DIR=/app-state

# Human-friendly label shown in UI (host/server location)
# In Codespaces you can leave it as ./Backups (repo folder).
BACKUP_DIR_LABEL=./Backups (host folder)

# Later on Windows server the Backup Settings utility may set:
# BACKUP_HOST_PATH=D:/StockControl/Backups
# BACKUP_DIR_LABEL=D:\StockControl\Backups

# Production-test web ports
APP_HTTP_PORT=8088
APP_HTTPS_PORT=8443
